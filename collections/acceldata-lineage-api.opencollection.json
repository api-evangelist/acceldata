{
  "opencollection": "1.0.0",
  "info": {
    "name": "Acceldata - Data Observability Cloud Alerts Lineage API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Lineage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Acceldata Get Dataset Lineage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.acceldata.app/v1/datasets/:id/lineage",
            "params": [
              {
                "name": "id",
                "value": "dataset-abc123",
                "type": "path",
                "description": "Dataset identifier."
              },
              {
                "name": "direction",
                "value": "both",
                "type": "query",
                "description": "Direction of lineage to retrieve (upstream, downstream, both)."
              },
              {
                "name": "depth",
                "value": "3",
                "type": "query",
                "description": "Maximum depth of lineage graph to return."
              }
            ]
          },
          "docs": "Get the data lineage graph for a dataset, showing upstream sources and downstream consumers."
        }
      ]
    }
  ],
  "bundled": true
}