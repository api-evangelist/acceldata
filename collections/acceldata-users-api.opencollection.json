{
  "opencollection": "1.0.0",
  "info": {
    "name": "Acceldata - Data Observability Cloud Alerts Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Acceldata List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.acceldata.app/v1/users",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number."
              },
              {
                "name": "limit",
                "value": "25",
                "type": "query",
                "description": "Results per page."
              }
            ]
          },
          "docs": "List all users in the Acceldata organization."
        }
      ]
    }
  ],
  "bundled": true
}