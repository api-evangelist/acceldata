{
  "opencollection": "1.0.0",
  "info": {
    "name": "Acceldata - Data Observability Cloud Alerts Data Quality Rules API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Data Quality Rules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Acceldata List Data Quality Rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.acceldata.app/v1/data-quality/rules",
            "params": [
              {
                "name": "dataset_id",
                "value": "dataset-abc123",
                "type": "query",
                "description": "Filter rules by dataset identifier."
              },
              {
                "name": "status",
                "value": "active",
                "type": "query",
                "description": "Filter rules by status (active, inactive)."
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number."
              },
              {
                "name": "limit",
                "value": "25",
                "type": "query",
                "description": "Results per page."
              }
            ]
          },
          "docs": "List all data quality monitoring rules configured in the platform."
        },
        {
          "info": {
            "name": "Acceldata Create Data Quality Rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.acceldata.app/v1/data-quality/rules",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new data quality monitoring rule for a dataset column."
        }
      ]
    }
  ],
  "bundled": true
}